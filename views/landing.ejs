<%- include('partials/header') %>

<section class="hero">
  <div>
    <h1>Welcome to Expense Tracker</h1>
    <p class="subtitle">A modern budget tool built for fast entry, clear reporting, and secure access.</p>
    <div class="hero-actions">
      <a href="/login" class="btn btn-primary">Log In</a>
      <a href="/register" class="btn btn-outline">Register</a>
    </div>
  </div>
  <div class="hero-panel">
    <h2>Manage your spending with confidence</h2>
    <ul class="hero-features">
      <li>Track daily expenses across categories</li>
      <li>See totals and recent items on the dashboard</li>
      <li>Edit or remove entries anytime</li>
      <li>Secure account-based access for your data</li>
    </ul>
  </div>
</section>

<section class="landing-details">
  <div class="detail-card">
    <h2>Simple budgeting</h2>
    <p>Enter expenses quickly and see how each purchase affects your monthly spend.</p>
  </div>
  <div class="detail-card">
    <h2>Organized by category</h2>
    <p>Create custom categories to understand where your money goes.</p>
  </div>
  <div class="detail-card">
    <h2>Insightful dashboard</h2>
    <p>View your total spend, entry count, and recent activity all from one screen.</p>
  </div>
</section>

<section class="landing-steps">
  <div class="steps-head">
    <h2>How it works</h2>
    <p>Get started in three easy steps and begin tracking your expenses today.</p>
  </div>

  <div class="step-cards">
    <div class="step-card">
      <span class="step-number">1</span>
      <h3>Create an account</h3>
      <p>Register with a username and password to keep your spending data private.</p>
    </div>
    <div class="step-card">
      <span class="step-number">2</span>
      <h3>Add expenses</h3>
      <p>Record each purchase, assign a category, and watch your totals update.</p>
    </div>
    <div class="step-card">
      <span class="step-number">3</span>
      <h3>Review your budget</h3>
      <p>Use the dashboard to review summary totals and keep your spending on track.</p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
