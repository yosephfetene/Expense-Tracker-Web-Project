<%- include('../partials/header') %>

<section class="page-head page-head-center">
  <div>
    <h1>Sign In</h1>
    <p class="subtitle">Securely access your dashboard, expenses, and categories.</p>
  </div>
</section>

<section class="panel auth-panel">
  <div class="auth-layout">
    <div class="auth-copy">
      <h2>Welcome back</h2>
      <p>Sign in to continue tracking your spending, stay organized, and get fast insights into your budget.</p>
      <ul class="auth-benefits">
        <li>Keep your spending history safe</li>
        <li>Manage expenses and categories</li>
        <li>View up-to-date totals and trends</li>
      </ul>
    </div>

    <div class="auth-form">
      <% if (error) { %>
        <p class="error-msg"><%= error %></p>
      <% } %>

      <form action="/login" method="POST" class="form">
        <div class="form-group">
          <label for="username">Username</label>
          <input id="username" name="username" type="text" value="<%= username %>" required autofocus>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required>
          <p class="password-note">Your password is case-sensitive.</p>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Log In</button>
        </div>
      </form>

      <p class="form-note">New here? <a href="/register">Create an account</a> to start tracking expenses.</p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
