<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Expense Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">Expense Tracker</a>
      <nav class="nav">
        <% if (user) { %>
          <a href="/dashboard" class="<%= title === 'Dashboard' ? 'active' : '' %>">Dashboard</a>
          <a href="/expenses" class="<%= title && title.includes('Expense') && title !== 'Dashboard' ? 'active' : '' %>">Expenses</a>
          <a href="/categories" class="<%= title === 'Categories' ? 'active' : '' %>">Categories</a>
        <% } %>
      </nav>
      <div class="auth-actions">
        <% if (user) { %>
          <span class="auth-label">Signed in as <strong><%= user %></strong></span>
          <a href="/logout" class="btn btn-outline">Logout</a>
        <% } else { %>
          <a href="/register" class="btn btn-outline <%= title === 'Register' ? 'active' : '' %>">Register</a>
          <a href="/login" class="btn btn-outline <%= title === 'Login' ? 'active' : '' %>">Login</a>
        <% } %>
      </div>
    </div>
  </header>
  <main class="container page">
