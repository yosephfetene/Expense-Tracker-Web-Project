<%- include('partials/header') %>

<section class="page-head">
  <div>
    <h1>Dashboard</h1>
    <p class="subtitle">A quick overview of your spending</p>
  </div>
  <a href="/expenses/add" class="btn btn-primary">+ Add Expense</a>
</section>

<section class="stats-grid">
  <div class="stat-card">
    <span class="stat-label">Total Spent</span>
    <span class="stat-value">$<%= Number(total).toFixed(2) %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Total Entries</span>
    <span class="stat-value"><%= count %></span>
  </div>
</section>

<section class="comparison-grid">
  <div class="comparison-card">
    <span class="stat-label">This month</span>
    <span class="stat-value">$<%= Number(dashboardComparison.currentMonth.total).toFixed(2) %></span>
    <span class="trend <%= dashboardComparison.currentMonth.trend === 'up' ? 'trend-up' : 'trend-down' %>">
      <%= dashboardComparison.currentMonth.sign %>$<%= Math.abs(dashboardComparison.currentMonth.difference).toFixed(2) %>
      <% if (dashboardComparison.currentMonth.percent !== null) { %>
        (<%= dashboardComparison.currentMonth.percent %>%)
      <% } %>
      vs last month
    </span>
  </div>
  <div class="comparison-card">
    <span class="stat-label">Last month</span>
    <span class="stat-value">$<%= Number(dashboardComparison.lastMonth.total).toFixed(2) %></span>
    <span class="trend muted"><%= dashboardComparison.lastMonth.month %></span>
  </div>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>Recent Expenses</h2>
    <a href="/expenses" class="link">View all &rarr;</a>
  </div>

  <% if (recent.length === 0) { %>
    <p class="empty">No expenses recorded yet. <a href="/expenses/add">Add your first one</a>.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Date</th>
          <th class="num">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% recent.forEach(function(expense) { %>
          <tr>
            <td><%= expense.title %></td>
            <td><span class="tag"><%= expense.category_name || 'Uncategorized' %></span></td>
            <td><%= new Date(expense.expense_date).toLocaleDateString() %></td>
            <td class="num">$<%= Number(expense.amount).toFixed(2) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('partials/footer') %>
