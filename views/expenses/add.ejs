<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <h1>Add Expense</h1>
    <p class="subtitle">Record a new expense</p>
  </div>
</section>

<section class="panel">
  <% if (typeof error !== 'undefined' && error) { %>
    <p class="error-msg"><%= error %></p>
  <% } %>

  <form action="/expenses/add" method="POST" class="form">
    <div class="form-group">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" placeholder="e.g. Groceries" required>
    </div>

    <div class="form-group">
      <label for="amount">Amount ($)</label>
      <input type="number" id="amount" name="amount" step="0.01" min="0" placeholder="0.00" required>
    </div>

    <div class="form-group">
      <label for="expense_date">Date</label>
      <input type="date" id="expense_date" name="expense_date" required>
    </div>

    <div class="form-group">
      <label for="category_id">Category</label>
      <select id="category_id" name="category_id">
        <option value="">Uncategorized</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat.id %>"><%= cat.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Expense</button>
      <a href="/expenses" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
