<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <h1>Edit Category</h1>
    <p class="subtitle">Rename this category. Existing expenses will keep using it.</p>
  </div>
</section>

<section class="panel">
  <% if (error) { %>
    <p class="error-msg"><%= error %></p>
  <% } %>

  <form action="/categories/edit/<%= category.id %>" method="POST" class="form">
    <div class="form-group">
      <label for="name">Category name</label>
      <input id="name" name="name" type="text" maxlength="50" required value="<%= category.name %>">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/categories" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
